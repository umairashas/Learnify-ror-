<p style="color: green"><%= notice %></p>

<% content_for :title, "Courses" %>

<h1 class="courses-heading">Courses</h1>

<turbo-frame id="course-content">
  <div id="courses" class="course-grid">
    <% @courses.each_with_index do |course, index| %>
      <div class="course-item" data-url="<%= course_path(course) %>">
        <span class="course-number"><%= index + 1 %>.</span>
        <span class="course-title"><%= course.title %></span>
        <% if current_user.role == 'student' %>
          <% if current_user.student.courses.include?(course) %>
            <%= video_tag url_for(course.video), controls: true if course.video.attached? %>
          <% else %>
            <p>You are not enrolled in this course.</p>
            <%= button_to "Enroll", enroll_course_path(course), method: :post, class: "btn btn-primary enroll-btn" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</turbo-frame>


<% if current_user.role == 'teacher' %>
  <%= link_to "Back", teacher_dashboard_path, class: "btn back-btn" %>
<% end %>

<style>
.course-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 40px;
  padding: 20px;
}

.course-item {
  cursor: pointer;
  padding: 15px 20px;
  width: 300px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  gap: 12px;
  transition: all 0.3s ease-in-out;
}

.course-item:hover {
  background: #667EEA;
  transform: scale(1.05);
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
}

.course-number {
  font-weight: bold;
  font-size: 20px;
  color: #000;
}

.course-title {
  font-size: 18px;
  font-weight: bold;
  color: rgb(12, 22, 76);
  transition: color 0.3s ease-in-out;
}

.courses-heading {
  font-size: 28px;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30px;
}

.back-btn {
  padding: 10px 20px;
  border-radius: 6px;
  width: 150px;
  text-decoration: none;
  font-weight: bold;
  font-size: 16px;
  text-align: center;
  transition: all 0.3s ease-in-out;
  cursor: pointer;
  border: none;
  outline: none;
  margin: 20px auto;
  display: block;
  background-color: #774EA2;
  color: white;
  border: 2px solid #774EA2;
}

.back-btn:hover {
  background-color: #9b7dc6;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".course-item").forEach(function (course) {
    course.addEventListener("click", function (event) {
      if (!event.target.closest(".enroll-btn")) {
        event.preventDefault();

        let courseUrl = this.getAttribute("data-url");

        Turbo.visit(courseUrl);
      }
    });
  });
});

</script>
