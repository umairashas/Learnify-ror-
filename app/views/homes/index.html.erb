
  <!-- Landing Page for Non-Signed-In Users -->
 
  <div class="landing-page">
    <div class="hero">
      <h1>Welcome to the Learning Platform</h1>
      <p>Join now to explore exciting courses and quizzes!</p>
      <div class="hero-images">
        <div class="image-slider">
          <img src="image.webp" alt="Studying Image" class="hero-image">
          <img src="image2.jpg" alt="Studying Image" class="hero-image">
          <img src="image3.jpg" alt="Studying Image" class="hero-image">
          <img src="image1.webp" alt="Studying Image" class="hero-image">
        </div>
      </div>
      <% if user_signed_in? %>
       <% if current_user.student? %>
    <%= link_to "Go to Dashboard", student_dashboard_path, class: 'btn btn-primary' %>
  <% else %>
    <%= link_to "Go to Dashboard", teacher_dashboard_path, class: 'btn btn-primary' %>
  <% end %>
  <% end %>
    </div>
  </div>


<style>
/* General Styles */
/* General Styles */
body {
  font-family: 'Arial', sans-serif;
  margin: 0;
  padding: 0;
  background: #f4f4f9;
  color: #333;
}

a {
  text-decoration: none;
  color: inherit;
}

/* Landing Page Styles */
.landing-page {
  text-align: center;
}

.hero {
  padding: 50px 20px;
  background: linear-gradient(to right, #667eea, #764ba2);
  border-radius: 12px;
  margin-top: 30px;
  width: 100%;
  min-height: 500px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}

.hero h1 {
  font-size: 2.5em;
  margin-bottom: 15px;
  font-weight: bold;
  color: white;
}

.hero p {
  font-size: 1.2em;
  margin-bottom: 25px;
  color: white;
}

.hero-images {
  display: flex;
  justify-content: center;
  overflow: hidden;
  position: relative;
  width: 100%;
  max-width: 600px;
  margin: auto;
}

.image-slider {
  display: flex;
  width: 400%;
  animation: slide 12s infinite;
}

.hero-image {
  width: 100%;
  max-width: 250px;
  height: auto;
  object-fit: cover;
  border-radius: 10px;
  margin: 10px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}

@keyframes slide {
  0% { transform: translateX(0); }
  25% { transform: translateX(-100%); }
  50% { transform: translateX(-200%); }
  75% { transform: translateX(-300%); }
  100% { transform: translateX(0); }
}

/* Button Styles */
.btn {
  display: inline-block;
  padding: 10px 20px;
  border-radius: 6px;
  font-weight: bold;
  transition: all 0.3s ease-in-out;
  font-size: 14px;
  text-align: center;
  border: none;
  cursor: pointer;
}

.btn-primary {
  background: #9353d3;
  color: white;
}

.btn:hover {
  opacity: 0.9;
  transform: translateY(-2px);
}

/* Responsive Design */
@media (max-width: 768px) {
  .hero h1 {
    font-size: 2em;
  }
}

</style>