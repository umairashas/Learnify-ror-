<% if user_signed_in? %>
  <!-- Dashboard for Signed-In Users -->
  <div class="dashboard">
    <h2>Welcome, <%= current_user.name || current_user.email %>!</h2>
    <div class="dashboard-content">
      <% if current_user.role == 'teacher' %>
        <!-- Teacher Dashboard -->
        <div class="teacher-dashboard">
          <h3>Teacher Dashboard</h3>
          <div class="actions">
            <%= link_to "Add Course", new_course_path(teacher_id: current_user.id), class: 'btn btn-primary' %>
            <%= link_to "View All Courses", courses_path, class: 'btn btn-secondary' %>
          </div>
          <div class="course-list">
            <% current_user.teacher.courses.each do |course| %>
              <div class="course-item">
                <span class="course-title"><%= course.title %></span>
                <div class="course-actions">
                  <%= link_to "View Students", enrolled_students_course_path(course), class: 'btn btn-small btn-info' %>
                  <%= link_to "Quiz Statistics", quiz_statistics_course_quizzes_path(course), class: 'btn btn-small btn-warning' %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<style>
body {
  font-family: 'Arial', sans-serif;
  margin: 0;
  padding: 0;
  background: #f4f4f9;
  color: #333;
}

a {
  text-decoration: none;
  color: inherit;
}

.dashboard {
  text-align: center;
  padding: 40px 20px;
  background: linear-gradient(135deg, #2575fc, #6a11cb);
  border-radius: 12px;
  margin: 40px auto;
  max-width: 1200px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  color: white;
}

.dashboard h2 {
  font-size: 2.2em;
  margin-bottom: 20px;
  font-weight: bold;
}

.dashboard-content {
  background: white;
  padding: 20px;
  border-radius: 10px;
  margin-top: 20px;
  color: #333;
}

.actions {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.course-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 15px;
}

.course-item {
  background: #ffffff;
  padding: 15px;
  border-radius: 8px;
  box-shadow: 0 8px 22px #667eea;
  display: flex;
  flex-direction: column;
  gap: 10px;
  justify-content: space-between;
  align-items: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.course-item:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 22px #667eea;
}

.course-title {
  font-weight: bold;
  font-size: 1.1em;
}

.course-actions {
  display: flex;
  gap: 10px;
}

.btn {
  display: inline-block;
  padding: 10px 20px;
  border-radius: 6px;
  font-weight: bold;
  transition: all 0.3s ease-in-out;
  font-size: 14px;
  text-align: center;
  border: none;
  cursor: pointer;
}

.btn-primary, .btn-secondary {
  background: #9353d3;
  color: white;
}

.btn-small {
  padding: 8px 12px;
  font-size: 12px;
  border-radius: 6px;
  font-weight: bold;
  transition: all 0.3s ease-in-out;
  border: none;
  cursor: pointer;
}

.btn-info, .btn-warning {
  background-color: #1491a1 !important;
  border: 1px solid #1e63e9 !important;
  color: white !important;
}

.btn:hover {
  opacity: 0.9;
  transform: translateY(-2px);
}

@media (max-width: 768px) {
  .dashboard {
    margin: 20px;
  }
  .actions {
    flex-direction: column;
  }
  .btn {
    width: 100%;
    margin-bottom: 10px;
  }
}
</style>